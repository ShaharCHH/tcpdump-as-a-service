# =============================================================================
# tcpdump-as-a-service — Hub environment variables
# Copy this file to .env and fill in the values for local development.
# In production these are set via the Helm ConfigMap and Secret.
# =============================================================================

# Authentication mode: "kubernetes" (token paste) or "openshift" (OAuth2 redirect)
AUTH_MODE=kubernetes

# Set to False for local development so the hub loads your local kubeconfig
# instead of the in-cluster service account.
K8S_IN_CLUSTER=false

# OpenShift OAuth (only required when AUTH_MODE=openshift)
# OPENSHIFT_API_URL=https://api.mycluster.example.com:6443
# OAUTH_CLIENT_ID=tcpdump-hub
# OAUTH_CLIENT_SECRET=changeme
# OAUTH_CALLBACK_URL=https://tcpdump.apps.mycluster.example.com/auth/callback

# Session cookie signing key — use a long random string in production
SECRET_KEY=dev-secret-key-change-me

# Capture limits
MAX_DURATION_MINUTES=30
MAX_CONCURRENT_CAPTURES=10
MAX_CONCURRENT_PER_USER=3

# pcap file storage (use a local path for development)
PCAP_STORAGE_PATH=./pcap_data
PCAP_TTL_HOURS=24
PCAP_MAX_FILES=10
PCAP_MAX_FILE_MB=50
PCAP_ROTATION_SECONDS=60

# In-cluster WebSocket URL agents use to reach the hub
# (only relevant when running inside the cluster; not needed for local dev)
# HUB_WS_URL=ws://tcpdump-as-a-service-hub.tcpdump-service.svc.cluster.local:8080

# Port the agent's local HTTP server listens on
AGENT_HTTP_PORT=8081

# Comma-separated list of k8s usernames that may view the audit log
# ADMIN_USERS=admin,ops-user
